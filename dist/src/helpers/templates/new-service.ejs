<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Service Request Received</title>
    <style>
      body {
        margin: 0;
        background-color: #f4f4f4;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2933;
      }

      .container {
        max-width: 640px;
        margin: 32px auto;
        background: #ffffff;
        border-radius: 10px;
        overflow: hidden;
      }

      .header {
        background: #f7f7f2;
        padding: 28px 32px 20px;
        border-bottom: 1px solid #e8e6df;
      }

      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #5f6c7b;
        margin-bottom: 12px;
      }

      h1 {
        font-size: 32px;
        line-height: 1.2;
        margin: 0;
        color: #273535;
      }

      .content {
        padding: 32px;
      }

      p {
        font-size: 16px;
        line-height: 1.7;
        color: #334e68;
        margin: 0 0 18px;
      }

      .highlight {
        background: #f6f8f4;
        border-left: 4px solid #5c6d76;
        padding: 18px 20px;
        border-radius: 8px;
        margin: 20px 0;
      }

      .details {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0 30px;
      }

      .details th,
      .details td {
        text-align: left;
        padding: 12px 10px;
        border-bottom: 1px solid #edf0f2;
        vertical-align: top;
        font-size: 14px;
      }

      .details th {
        width: 40%;
        color: #52606d;
        font-weight: 600;
      }

      .button {
        display: inline-block;
        background: #5c6d76;
        color: #ffffff !important;
        text-decoration: none;
        font-weight: bold;
        padding: 14px 24px;
        border-radius: 6px;
        margin-top: 10px;
      }

      .footer {
        background: #fafafa;
        padding: 24px 32px;
        text-align: center;
        font-size: 12px;
        color: #6b7280;
      }

      @media (max-width: 600px) {
        .container {
          margin: 0;
          border-radius: 0;
        }

        .header,
        .content,
        .footer {
          padding-left: 20px;
          padding-right: 20px;
        }

        h1 {
          font-size: 26px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="eyebrow">Ajike Pest Control</div>
        <h1>Service Request Received</h1>
      </div>

      <div class="content">
        <p>Hello Admin,</p>
        <p>
          You have a new service request:
          <strong><%= title %></strong>.
        </p>

        <div class="highlight">
          <p><strong>Service summary:</strong> <%= summary %></p>
          <p><strong>Status:</strong> <%= status %></p>
        </div>

        <table class="details" aria-label="Service details">
          <tr>
            <th>Property Type</th>
            <td><%= propertyType %></td>
          </tr>
          <tr>
            <th>Service Category</th>
            <td><%= category %></td>
          </tr>
          <tr>
            <th>Service Location</th>
            <td><%= serviceLocation %></td>
          </tr>
          <tr>
            <th>Plan</th>
            <td><%= plan %></td>
          </tr>
          <tr>
            <th>Budget</th>
            <td><%= budget %></td>
          </tr>
          <tr>
            <th>Address</th>
            <td><%= address %></td>
          </tr>
          <tr>
            <th>Customer Email</th>
            <td><%= email %></td>
          </tr>
          <tr>
            <th>Phone Number</th>
            <td><%= phoneNumber %></td>
          </tr>
        </table>

        <a href="<%= dashboardURl %>" class="button" style="color: #ffffff"
          >View Request</a
        >
      </div>

      <div class="footer">
        <p>
          This is an automated message, please do not reply directly to this
          email.
        </p>
        <p>&copy; 2026 Ajike Pest Control. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
